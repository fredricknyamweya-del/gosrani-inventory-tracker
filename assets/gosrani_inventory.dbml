// Gosrani Wholesalers Limited, Eldoret, Kenya: Inventory Management System
// Database: PostgreSQL (Supabase)
// Paste into https://dbdiagram.io to view the diagram.
//
// Design rules that keep this schema free of circular references and duplicated data:
//   1. Dependencies only point "down" (see creation order at the bottom). No table refers back up.
//   2. A record points ONLY to a specification. Its item and category are reached through the
//      specification, so there is no item -> specification -> record -> item triangle.
//   3. Names are never copied onto records. A record shows current catalog names.
//   4. Stock is calculated from records, never stored.

Project gosrani_inventory {
  database_type: 'PostgreSQL'
  Note: '''
    Gosrani Wholesalers Limited inventory system.
    Timestamps are stored as UTC (timestamptz). record_date is a plain date shown as DD/MM/YYYY.
  '''
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

Enum user_role {
  Admin
  User
}

Enum user_status {
  Active
  Inactive
}

Enum stock_unit {
  PCS [note: 'Counted in pieces']
  KG  [note: 'Weighed in kilograms (fibre)']
}

Enum entered_unit {
  PCS
  BALE
  KG
}

Enum item_entry_unit {
  PCS
  BALE
  KG
}

Enum record_status {
  Saved
  Locked
}

Enum request_status {
  Pending
  Approved
  Rejected
}

Enum audit_action {
  create
  update
  lock
  delete
  approve
  reject
}

Enum audit_entity {
  inventory_record
  category
  item
  specification
  user
  item_request
}

Enum token_type {
  access
  refresh
}

// ---------------------------------------------------------------------------
// Level 0: tables with no dependencies
// ---------------------------------------------------------------------------

Table locations {
  id     bigint      [pk, increment]
  code   varchar(10) [not null, unique, note: 'Short code, for example ELD']
  name   varchar(100) [not null]
  active boolean     [not null, default: true]

  Note: 'Physical sites. One row today (Eldoret Godown). Add rows to scale to 5 locations.'
}

Table users {
  id            bigint       [pk, increment]
  name          varchar(120) [not null]
  email         varchar(254) [not null, note: 'Stored in lowercase']
  password_hash text         [not null]
  role          user_role    [not null, default: 'User']
  status        user_status  [not null, default: 'Active']
  failed_logins int          [not null, default: 0]
  locked_until  timestamptz  [null, note: 'Temporary lockout after repeated failed logins']
  last_login_at timestamptz  [null]
  created_at    timestamptz  [not null, default: `now()`]

  indexes {
    (`lower(email)`) [unique, name: 'users_email_lower_uq']
  }

  Note: 'Admins can use every location. Users are limited to the rows in user_locations.'
}

Table categories {
  id         bigint       [pk, increment]
  name       varchar(100) [not null]
  sort_order int          [not null, default: 0]
  active     boolean      [not null, default: true]

  indexes {
    (`lower(trim(name))`) [unique, name: 'categories_name_uq']
  }
}

// ---------------------------------------------------------------------------
// Level 1: depend on level 0 only
// ---------------------------------------------------------------------------

Table user_locations {
  user_id     bigint [not null, ref: > users.id]
  location_id bigint [not null, ref: > locations.id]

  indexes {
    (user_id, location_id) [pk]
  }

  Note: 'Which locations a staff member may work in. Admins do not need rows here.'
}

Table items {
  id          bigint       [pk, increment]
  category_id bigint       [not null, ref: > categories.id]
  name        varchar(120) [not null]
  unit        stock_unit   [not null, default: 'PCS', note: 'Base unit used for all quantities of this item']
  entry_unit  item_entry_unit [not null, default: 'PCS', note: 'The only unit staff may use for new entries']
  active      boolean      [not null, default: true, note: 'Deactivate instead of deleting. History is kept']

  indexes {
    (category_id, `lower(trim(name))`) [unique, name: 'items_name_per_category_uq']
  }

  checks {
    `entry_unit IN ('PCS', 'BALE', 'KG')` [name: 'items_entry_unit_valid']
  }

  Note: 'The product. Size, colour, or weight variants live in specifications.'
}

Table import_batches {
  id          bigint       [pk, increment]
  source_file varchar(255) [not null]
  imported_by bigint       [not null, ref: > users.id]
  row_count   int          [not null]
  notes       text         [null]
  imported_at timestamptz  [not null, default: `now()`]

  Note: 'One row per Excel import, so a bad import can be found and reversed.'
}

Table item_requests {
  id                 bigint       [pk, increment]
  requested_by       bigint       [not null, ref: > users.id]
  category_id        bigint       [null, ref: > categories.id, note: 'Existing category, or null if a new one is requested']
  new_category_name  varchar(100) [null]
  item_name          varchar(120) [not null]
  specification      varchar(120) [null]
  note               text         [null]
  status             request_status [not null, default: 'Pending']
  reviewed_by        bigint       [null, ref: > users.id]
  reject_reason      text         [null]
  created_at         timestamptz  [not null, default: `now()`]
  reviewed_at        timestamptz  [null]

  checks {
    `(category_id IS NOT NULL) <> (new_category_name IS NOT NULL)` [name: 'request_has_one_category']
  }

  Note: 'Staff request for a catalog entry that is missing. Approval creates the catalog rows.'
}

Table audit_log {
  id          bigint       [pk, increment]
  entity_type audit_entity [not null]
  entity_id   bigint       [not null, note: 'Id of the row in the table named by entity_type. Deliberately not a foreign key']
  action      audit_action [not null]
  actor_id    bigint       [not null, ref: > users.id]
  before      jsonb        [null]
  after       jsonb        [null]
  at          timestamptz  [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, at)
    (actor_id, at)
  }

  Note: '''
    One table records history for every kind of data.
    entity_type and entity_id point at the changed row without a foreign key, so the log
    survives any later removal and needs no extra link columns.
  '''
}

Table assistant_queries {
  id           bigint      [pk, increment]
  user_id      bigint      [not null, ref: > users.id]
  question     text        [not null]
  tools_called jsonb       [null, note: 'Which read-only query functions the assistant used']
  result_count int         [null]
  at           timestamptz [not null, default: `now()`]

  Note: 'Admin-only AI assistant log, for review and cost control.'
}

Table revoked_tokens {
  jti        varchar(64) [pk, note: 'JWT id of a token that was logged out or rotated']
  token_type token_type  [not null]
  user_id    bigint      [not null, ref: > users.id]
  expires_at timestamptz [not null, note: 'Row can be purged after this time']
  revoked_at timestamptz [not null, default: `now()`]

  indexes {
    expires_at
  }

  Note: 'Server-side blocklist that makes JWT logout and refresh-token rotation possible.'
}

// ---------------------------------------------------------------------------
// Level 2: depend on level 1
// ---------------------------------------------------------------------------

Table specifications {
  id         bigint       [pk, increment]
  item_id    bigint       [not null, ref: > items.id]
  label      varchar(120) [not null, note: 'For example 4x6, 600g, Blue']
  pack_size  int          [null, note: 'Pieces per bale. Null if the product is not baled']
  is_default boolean      [not null, default: false, note: 'True for the single hidden "Standard" row of items with no real sizes']
  active     boolean      [not null, default: true]

  indexes {
    (item_id, `lower(trim(label))`) [unique, name: 'specifications_label_per_item_uq']
  }

  checks {
    `pack_size IS NULL OR pack_size > 0` [name: 'pack_size_positive']
  }

  Note: '''
    Every item has at least one specification. An item with no real sizes (Duvet Bags, Fibre)
    gets one default row labelled Standard, so records can always point at a specification.
    Rules enforced by the API:
      - pack_size cannot change once records exist. Create a new specification instead.
      - at most one default specification per item.
  '''
}

// ---------------------------------------------------------------------------
// Level 3: the main data
// ---------------------------------------------------------------------------

Table inventory_records {
  id               bigint         [pk, increment, note: 'Shown as INV-000123 by the API. Never reused']
  location_id      bigint         [not null, ref: > locations.id]
  record_date      date           [not null]
  specification_id bigint         [not null, ref: > specifications.id, note: 'Item and category are reached through this']
  qty_in           decimal(12,3)  [null, note: 'In the item base unit (pieces or kg)']
  qty_out          decimal(12,3)  [null, note: 'In the item base unit (pieces or kg)']
  pieces_per_bale  int            [null, note: 'Conversion used by this BALE entry; stock quantities remain base units']
  entered_unit     entered_unit   [not null, default: 'PCS', note: 'How staff typed it, for display. Stock maths always uses the base unit']
  details          text           [null]
  status           record_status  [not null, default: 'Locked']
  created_by       bigint         [not null, ref: > users.id]
  created_at       timestamptz    [not null, default: `now()`]
  updated_by       bigint         [null, ref: > users.id]
  updated_at       timestamptz    [null]
  deleted_at       timestamptz    [null, note: 'Soft delete. Null means the record is live']
  import_batch_id  bigint         [null, ref: > import_batches.id]

  indexes {
    (location_id, record_date)
    (location_id, specification_id, record_date)
  }

  checks {
    `qty_in IS NOT NULL OR qty_out IS NOT NULL` [name: 'has_a_quantity']
    `qty_in >= 0 AND qty_out >= 0`              [name: 'quantities_non_negative']
    `pieces_per_bale IS NULL OR pieces_per_bale > 0` [name: 'pieces_per_bale_positive']
  }

  Note: '''
    One row per stock movement (the seven fields: date, category, item, size, in, out, details).
    The category and item come from specification -> item -> category, so names are never copied here.
    Stock = sum(qty_in) - sum(qty_out) per location and specification, where deleted_at is null.
    Recommended partial indexes (DBML cannot express them), add in the migration:
      CREATE INDEX ON inventory_records (location_id, record_date) WHERE deleted_at IS NULL;
      CREATE UNIQUE INDEX ON specifications (item_id) WHERE is_default;
  '''
}

// ---------------------------------------------------------------------------
// Stock view (create with a migration; shown here as a comment for reference)
// ---------------------------------------------------------------------------
//
