// SELECT location_id,
//        specification_id,
//        COALESCE(SUM(qty_in), 0) - COALESCE(SUM(qty_out), 0) AS stock
// FROM inventory_records
// WHERE deleted_at IS NULL
// GROUP BY location_id, specification_id;
//
// ---------------------------------------------------------------------------
// Table creation order (no table depends on a later one, so there are no circles)
// ---------------------------------------------------------------------------
//   0. locations, users, categories
//   1. user_locations, items, import_batches, item_requests, audit_log, assistant_queries, revoked_tokens
//   2. specifications
//   3. inventory_records
