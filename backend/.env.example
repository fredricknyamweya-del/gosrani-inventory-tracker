# Environment profile: development, testing, or production.
APP_ENV=development
# Flask session and signing secret; provide a unique secret outside development.
SECRET_KEY=
# JWT signing secret; provide a unique secret outside development.
JWT_SECRET_KEY=
# Optional database URL; leave blank for local SQLite. Production requires PostgreSQL.
DATABASE_URL=
# Optional database URL used to run tests against PostgreSQL.
TEST_DATABASE_URL=
# Optional separate read-only database URL for assistant queries.
ASSISTANT_DATABASE_URL=
# Comma-separated explicit browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
# Whether auth cookies require HTTPS; true in production.
COOKIE_SECURE=false
# Cookie SameSite policy; use Lax for same-site deployments.
COOKIE_SAMESITE=Lax
# Optional cookie domain shared by the frontend and API.
COOKIE_DOMAIN=
# Access token lifetime in minutes.
JWT_ACCESS_MINUTES=15
# Refresh token lifetime in hours.
JWT_REFRESH_HOURS=12
# Failed login attempts before temporary lockout.
LOGIN_MAX_FAILURES=5
# Login lockout duration in minutes.
LOGIN_LOCK_MINUTES=15
# Flask-Caching backend: SimpleCache, RedisCache, or NullCache.
CACHE_TYPE=SimpleCache
# Server-side cache lifetime in seconds.
CACHE_DEFAULT_TIMEOUT=60
# Optional Redis URL; selects RedisCache when set.
REDIS_URL=
# Optional OpenAI API key; without it the assistant uses its built-in responses.
OPENAI_API_KEY=
# OpenAI model used to phrase answers from read-only database results.
OPENAI_MODEL=gpt-4.1-mini
# Maximum assistant questions per user per hour.
ASSISTANT_HOURLY_LIMIT=30
# Quantity level that triggers an inventory review warning.
LARGE_QUANTITY_THRESHOLD=500
# Default location short code used by the seed command.
DEFAULT_LOCATION_CODE=ELD
# Default location name used by the seed command.
DEFAULT_LOCATION_NAME=Gosrani Technical Office
# Initial Admin email; set through the environment only.
SEED_ADMIN_EMAIL=
# Initial Admin display name.
SEED_ADMIN_NAME=Gosrani Office-Primary Admin
# Initial Admin password; set through the environment only.
SEED_ADMIN_PASSWORD=
