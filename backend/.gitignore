# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment files and secrets (keep the example)
.env
.env.*
!.env.example

# Flask instance folder: ignore the database and local config, keep the folder
instance/*
!instance/.gitkeep

# Local databases
*.db
*.sqlite
*.sqlite3

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/

# Test coverage
.coverage
htmlcov/
coverage.xml

# Logs
*.log
logs/